<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hero Alt Layout — Mockup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500&family=Space+Mono:wght@400;700&display=swap">
<style>

/* ─── Design Tokens (matching production site) ─── */
:root {
  --bg:          #1c1c1e;
  --bg-2:        #222224;
  --bg-3:        #282828;
  --surface:     #242426;
  --border:      #2e2e32;
  --border-mid:  #3a3a3e;
  --muted:       #52525a;
  --mid:         #7a7a84;
  --text:        #d0d0d8;
  --bright:      #eeeef2;
  --accent:      #c8a46e;
  --accent-dim:  #6e5830;
  --accent-light:#d4b580;
  --font-head:   'Outfit', system-ui, sans-serif;
  --font-body:   'Inter', system-ui, sans-serif;
  --font-mono:   'Space Mono', monospace;
  --max:         1140px;
  --radius:      6px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { background: #1c1c1e; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}


/* ─── ANNOTATION STRIP ─── */
.annotation-strip {
  background: #0a0a0c;
  border-bottom: 1px solid #c8a46e44;
  padding: 10px 32px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.annotation-strip-label {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--accent);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.annotation-strip-note {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--muted);
}


/* ─── NAV (condensed/sticky state for reference) ─── */
.nav-wrap {
  background: rgba(28,28,30,0.97);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 32px;
  height: 62px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-id {
  display: flex;
  flex-direction: column;
  gap: 3px;
  line-height: 1;
  text-decoration: none;
}
.nav-name {
  font-family: var(--font-head);
  font-size: 22px;
  font-weight: 700;
  color: var(--bright);
  letter-spacing: -0.015em;
}
.nav-sub {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.nav-sub span { color: var(--border-mid); margin: 0 4px; }
.nav-links { display: flex; align-items: center; gap: 2px; }
.nav-item {
  padding: 7px 13px;
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 500;
  color: var(--mid);
  border-radius: 4px;
  text-decoration: none;
  transition: color 0.2s;
}
.nav-item:hover { color: var(--text); }
.nav-shop {
  margin-left: 8px;
  padding: 7px 15px;
  font-family: var(--font-head);
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  border: 1px solid var(--accent-dim);
  border-radius: 4px;
  text-decoration: none;
}
.nav-label {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-left: 10px;
  padding: 2px 6px;
  border: 1px solid var(--accent-dim);
  border-radius: 3px;
  opacity: 0.7;
}


/* ─── SPLIT HERO ─── */
.hero-split-wrap {
  background: var(--bg-2);
  border-bottom: 1px solid var(--border);
  padding: 0 32px;
}

.hero-split-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 0;
  align-items: stretch;
  min-height: 540px;
}


/* ── LEFT COLUMN: Identity ── */
.hero-identity {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 56px 56px 56px 0;
  border-right: 1px solid var(--border);
}

.hero-eyebrow {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--accent);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.hero-eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--accent);
  opacity: 0.5;
}

.hero-name {
  font-family: var(--font-head);
  font-size: clamp(52px, 6.5vw, 80px);
  font-weight: 800;
  color: var(--bright);
  letter-spacing: -0.035em;
  line-height: 0.95;
  margin-bottom: 24px;
}

/* Accent on last name */
.hero-name .last { color: var(--accent); }

.hero-tagline {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--mid);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.hero-tagline-sep {
  color: var(--border-mid);
  font-size: 14px;
  font-weight: 300;
}

.hero-desc {
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--muted);
  line-height: 1.7;
  max-width: 420px;
  margin-bottom: 40px;
}

.hero-ctas {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 600;
  border-radius: var(--radius);
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.2s;
}
.btn-gold {
  color: var(--accent);
  border-color: var(--accent-dim);
  background: rgba(200,164,110,0.07);
}
.btn-gold:hover { border-color: var(--accent); background: rgba(200,164,110,0.12); }
.btn-ghost {
  color: var(--mid);
  border-color: var(--border);
  background: transparent;
}
.btn-ghost:hover { border-color: var(--border-mid); color: var(--text); }

.hero-stats {
  margin-top: 44px;
  padding-top: 28px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 32px;
}
.hero-stat-num {
  font-family: var(--font-head);
  font-size: 26px;
  font-weight: 700;
  color: var(--bright);
  letter-spacing: -0.03em;
  line-height: 1;
}
.hero-stat-label {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-top: 5px;
}


/* ── RIGHT COLUMN: Portrait Gallery ── */
.hero-gallery-col {
  display: flex;
  flex-direction: column;
  padding: 28px 0 28px 28px;
  position: relative;
}

.hero-gallery-frame {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  position: relative;
  /* Portrait 3:4 */
  aspect-ratio: 3/4;
  max-height: 490px;
  background: var(--bg-3);
}

/* Placeholder slides (no real images — using gradient fills) */
.port-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.8s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}
.port-slide.active { opacity: 1; }
.port-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Placeholder gradient fills (since we have no portrait crops yet) */
.ps-1 { background: linear-gradient(160deg, #1e1428 0%, #141430 40%, #1e2028 100%); }
.ps-2 { background: linear-gradient(160deg, #1e2818 0%, #142018 40%, #201e14 100%); }
.ps-3 { background: linear-gradient(160deg, #281820 0%, #181828 40%, #1e2020 100%); }

.port-placeholder-label {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-align: center;
  padding: 16px;
  line-height: 1.8;
}

/* Slide overlay gradient */
.port-slide-grad {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120px;
  background: linear-gradient(to top, rgba(20,20,22,0.9) 0%, transparent 100%);
  z-index: 2;
  pointer-events: none;
}

/* Gallery nav arrows */
.port-arrows {
  position: absolute;
  bottom: 16px;
  right: 16px;
  display: flex;
  gap: 6px;
  z-index: 10;
}
.port-arrow {
  width: 30px;
  height: 30px;
  background: rgba(20,20,22,0.8);
  border: 1px solid var(--border-mid);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: var(--mid);
  cursor: pointer;
  transition: all 0.2s;
  user-select: none;
}
.port-arrow:hover { color: var(--bright); background: rgba(20,20,22,0.95); }

/* Gallery dots */
.port-dots {
  position: absolute;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 5px;
  z-index: 10;
}
.port-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--border-mid);
  cursor: pointer;
  transition: all 0.3s;
}
.port-dot.active { width: 16px; border-radius: 3px; background: var(--accent); }

/* Gallery label below frame */
.hero-gallery-label {
  margin-top: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-gallery-label-left {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.hero-gallery-label-count {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--border-mid);
  letter-spacing: 0.1em;
}


/* ─── ANNOTATION CALLOUTS ─── */
.callout-wrap {
  max-width: var(--max);
  margin: 0 auto;
  padding: 24px 0 8px;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 0;
}
.callout {
  background: #0e0e10;
  border: 1px solid #2e2e3288;
  border-radius: 4px;
  padding: 12px 16px;
  margin: 0 4px;
}
.callout-right { margin-left: 28px; }
.callout-title {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--accent);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-bottom: 6px;
}
.callout-body {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--muted);
  line-height: 1.6;
}
.callout-body li { margin-left: 14px; margin-bottom: 3px; }


/* ─── SECTION BELOW (for context) ─── */
.divider-label {
  border-top: 1px solid var(--border);
  padding: 16px 32px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--bg);
}
.divider-label-text {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--muted);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.divider-label-line {
  flex: 1;
  height: 1px;
  background: var(--border);
}


/* ─── OPTION B NOTE (name-only tweak) ─── */
.option-b-wrap {
  background: var(--bg);
  padding: 28px 32px;
  border-bottom: 1px solid var(--border);
}
.option-b-inner {
  max-width: var(--max);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 40px;
}
.option-b-nav-mock {
  background: rgba(28,28,30,0.97);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0 24px;
  height: 62px;
  display: flex;
  align-items: center;
  gap: 24px;
  flex-shrink: 0;
}
.option-b-name-small { font-family: var(--font-head); font-size: 20px; font-weight: 700; color: var(--muted); letter-spacing: -0.01em; }
.option-b-name-large { font-family: var(--font-head); font-size: 26px; font-weight: 700; color: var(--bright); letter-spacing: -0.02em; }
.option-b-arrow { font-family: var(--font-mono); font-size: 11px; color: var(--accent); }
.option-b-note { font-family: var(--font-body); font-size: 12px; color: var(--mid); line-height: 1.7; }
.option-b-note strong { color: var(--text); }

</style>
</head>
<body>

<!-- ── TOP ANNOTATION ── -->
<div class="annotation-strip">
  <div class="annotation-strip-label">Mockup</div>
  <div class="annotation-strip-note">Alt homepage layout — split hero / Option A. Uses real design tokens. Portrait gallery uses gradient placeholders until portrait-crop images are prepared.</div>
</div>


<!-- ── NAV (condensed/sticky reference — unchanged from current) ── -->
<div class="nav-wrap">
  <nav class="nav">
    <a href="#" class="nav-id">
      <div class="nav-name">William McGuire</div>
      <div class="nav-sub">Illustration <span>·</span> Concept Art <span>·</span> Animation</div>
    </a>
    <div class="nav-links">
      <a href="#" class="nav-item">Gallery</a>
      <a href="#" class="nav-item">About</a>
      <a href="#" class="nav-item">Contact</a>
      <a href="#" class="nav-shop">Shop ↗</a>
    </div>
  </nav>
</div>


<!-- ── SPLIT HERO ── -->
<div class="hero-split-wrap">
  <div class="hero-split-inner">

    <!-- LEFT: Identity -->
    <div class="hero-identity">
      <div class="hero-eyebrow">Visual Artist · Seattle, WA</div>
      <div class="hero-name">William<br><span class="last">McGuire</span></div>
      <div class="hero-tagline">
        Illustration
        <span class="hero-tagline-sep">/</span>
        Concept Art
        <span class="hero-tagline-sep">/</span>
        Animation
        <span class="hero-tagline-sep">/</span>
        Toy Design
      </div>
      <div class="hero-desc">
        20+ years creating characters, worlds, and stories for Microsoft, Amazon, Paramount, LeapFrog, and beyond. From concept to final — across screens, shelves, and pages.
      </div>
      <div class="hero-ctas">
        <a href="#" class="btn btn-gold">View Gallery</a>
        <a href="#" class="btn btn-ghost">About William</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="hero-stat-num">350+</div>
          <div class="hero-stat-label">Works</div>
        </div>
        <div>
          <div class="hero-stat-num">20+</div>
          <div class="hero-stat-label">Clients</div>
        </div>
        <div>
          <div class="hero-stat-num">6</div>
          <div class="hero-stat-label">Disciplines</div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Portrait Gallery -->
    <div class="hero-gallery-col">
      <div class="hero-gallery-frame" id="portFrame">

        <div class="port-slide active ps-1" data-index="0">
          <div class="port-placeholder-label">
            Portrait-crop image<br>
            <span style="color:var(--accent);">HeroGallery1.jpg</span><br>
            ~3:4 or 9:16 crop
          </div>
        </div>

        <div class="port-slide ps-2" data-index="1">
          <div class="port-placeholder-label">
