            <span style="color:var(--accent);">HeroGallery3.jpg</span><br>
            ~3:4 or 9:16 crop
          </div>
        </div>

        <div class="port-slide ps-3" data-index="2">
          <div class="port-placeholder-label">
            Portrait-crop image<br>
            <span style="color:var(--accent);">HeroGallery2.jpg</span><br>
            ~3:4 or 9:16 crop
